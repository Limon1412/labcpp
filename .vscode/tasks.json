{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build Lab1 (C++20)",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "${workspaceFolder}/Lab1/main.cpp",
                "${workspaceFolder}/Lab1/Goods.cpp",
                "-o",
                "${workspaceFolder}/Lab1/app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build Lab1 with GCC and C++20."
        }
    ],
    "version": "2.0.0"
}
